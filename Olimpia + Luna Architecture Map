<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
<script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/topojson-client@3.1.0/dist/topojson-client.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/us-atlas@3/states-10m.json"></script>
<div id="luna-map" class="p-4 sm:p-6 rounded-2xl bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
<style>
#luna-map .box{border:1px solid #94a3b8;border-radius:14px;padding:14px;background:#fff;box-shadow:0 4px 12px rgba(15,23,42,.07)}
#luna-map .arrow{text-align:center;font-size:24px;color:#64748b;line-height:1.2;padding:4px}
#luna-map .tag{display:inline-block;padding:2px 8px;border-radius:999px;font-size:12px;font-weight:700;margin-bottom:6px}
#luna-map .cs{background:#ede9fe;color:#5b21b6}.cpp{background:#dbeafe;color:#1d4ed8}.asm{background:#dcfce7;color:#166534}.dll{background:#fee2e2;color:#991b1b}
#luna-map code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px}
#luna-map button:focus-visible{outline:3px solid #38bdf8;outline-offset:2px}
@media(prefers-color-scheme:dark){#luna-map .box{background:#0f172a;border-color:#475569;box-shadow:none}#luna-map .arrow{color:#94a3b8}}
</style>
<div class="flex flex-wrap items-center justify-between gap-3 mb-5">
  <div><h2 class="text-xl font-bold">Olimpia → Luna Architecture Map</h2><p class="text-sm text-slate-600 dark:text-slate-400">C# → P/Invoke → C++ DLL export → x64 NASM kernel</p></div>
  <button type="button" id="toggle-details" class="px-3 py-2 rounded-lg bg-indigo-600 text-white font-semibold hover:bg-indigo-700">Show details</button>
</div>
<div class="grid lg:grid-cols-3 gap-4 items-start">
  <section class="space-y-2">
    <div class="box"><span class="tag cs">Olimpia.UI / App</span><h3 class="font-bold">Program.cs</h3><code>brain.Predict(2f, 3f)</code><div class="details hidden mt-2 text-sm">Application entry point. Creates the Brain and prints the prediction.</div></div>
    <div class="arrow">↓</div>
    <div class="box"><span class="tag cs">Olimpia.Core</span><h3 class="font-bold">Brain</h3><code>Layer.Forward(x1, x2)[0]</code><div class="details hidden mt-2 text-sm">Owns the neural layer and initializes neuron weights and bias.</div></div>
    <div class="arrow">↓</div>
    <div class="box"><span class="tag cs">Olimpia.Core</span><h3 class="font-bold">Layer</h3><code>Neuron.Compute(x1, x2)</code><div class="details hidden mt-2 text-sm">Processes all neurons and returns their output array.</div></div>
    <div class="arrow">↓</div>
    <div class="box"><span class="tag cs">Olimpia.Core</span><h3 class="font-bold">Neuron</h3><code>Luna.ComputeNeuron(...)</code><div class="details hidden mt-2 text-sm">Passes x1, x2, W1, W2 and Bias into the native Luna layer.</div></div>
  </section>
  <section class="space-y-2">
    <div class="box border-indigo-400"><span class="tag cs">Olimpia.Interop</span><h3 class="font-bold">Luna.cs</h3><code>[DllImport("Luna.dll", CallingConvention=Cdecl)]</code><div class="details hidden mt-2 text-sm">P/Invoke boundary between managed C# and native code.</div></div>
    <div class="arrow">↓</div>
    <div class="box"><span class="tag dll">Luna.dll</span><h3 class="font-bold">Native library</h3><code>ComputeNeuron</code><div class="details hidden mt-2 text-sm">Contains the exported C++ function and linked ASM object.</div></div>
    <div class="arrow">↓</div>
    <div class="box"><span class="tag cpp">C++ Export</span><h3 class="font-bold">LunaExport.cpp</h3><code>ComputeNeuron(...) → LunaNeuron(...)</code><div class="details hidden mt-2 text-sm">Exports a stable C ABI function and forwards the call to the assembly kernel.</div></div>
    <div class="arrow">↓</div>
    <div class="box"><span class="tag asm">Luna Heart</span><h3 class="font-bold">Luna.asm</h3><code>LunaNeuron</code><div class="details hidden mt-2 text-sm">Performs scalar SSE operations using Windows x64 argument registers.</div></div>
  </section>
  <section class="space-y-3">
    <div class="box"><span class="tag asm">ASM Formula</span><h3 class="font-bold mb-2">Neuron calculation</h3><div class="text-lg font-semibold">y = x1 × w1 + x2 × w2 + bias</div></div>
    <div class="box"><h3 class="font-bold mb-2">Example</h3><code>2 × 0.5 + 3 × 0.8 + 0.1</code><div class="mt-2 text-2xl font-bold text-emerald-600">Prediction = 3.5</div></div>
    <div class="box"><h3 class="font-bold mb-2">Windows x64 mapping</h3><ul class="text-sm space-y-1"><li><b>XMM0</b> = x1</li><li><b>XMM1</b> = x2</li><li><b>XMM2</b> = w1</li><li><b>XMM3</b> = w2</li><li><b>[RSP+40]</b> = bias</li><li><b>XMM0</b> = return value</li></ul></div>
  </section>
</div>
<div aria-live="polite" id="status" class="sr-only"></div>
<script>
(()=>{const root=document.getElementById('luna-map');const btn=root.querySelector('#toggle-details');const details=[...root.querySelectorAll('.details')];const status=root.querySelector('#status');let open=false;btn.addEventListener('click',()=>{open=!open;details.forEach(x=>x.classList.toggle('hidden',!open));btn.textContent=open?'Hide details':'Show details';status.textContent=open?'Architecture details shown':'Architecture details hidden';});})();
</script>
</div>

